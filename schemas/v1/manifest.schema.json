{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exhibitiq.invalid/schemas/v1/manifest.schema.json",
  "title": "Manifest",
  "description": "資料包清單",
  "type": "object",
  "required": [
    "schema_version",
    "dataset_id",
    "exhibition_id",
    "edition_id",
    "edition_year",
    "created_at",
    "data_origin",
    "producer",
    "previous_dataset_id",
    "crawl_run_ids",
    "source_snapshot_ids",
    "files",
    "record_counts",
    "content_hash",
    "completeness_status",
    "completeness"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0-draft.1",
      "description": "草案期必須與 schemas/v1/VERSION 完全相同。"
    },
    "dataset_id": {
      "$ref": "common.schema.json#/$defs/dataset_id"
    },
    "exhibition_id": {
      "$ref": "common.schema.json#/$defs/exhibition_id"
    },
    "edition_id": {
      "$ref": "common.schema.json#/$defs/edition_id"
    },
    "edition_year": {
      "type": "integer",
      "minimum": 1900,
      "maximum": 2100
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/utc_timestamp"
    },
    "data_origin": {
      "$ref": "common.schema.json#/$defs/data_origin"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "$ref": "common.schema.json#/$defs/short_text"
        },
        "version": {
          "$ref": "common.schema.json#/$defs/short_text"
        },
        "code_commit": {
          "$ref": "common.schema.json#/$defs/git_commit"
        }
      }
    },
    "previous_dataset_id": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/dataset_id"
        },
        {
          "type": "null"
        }
      ],
      "description": "同一屆的上一個資料包；第一個資料包為 null。"
    },
    "crawl_run_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/crawl_run_id"
      }
    },
    "source_snapshot_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/source_id"
      },
      "description": "本資料包引用的所有來源 ID，必須與 sources.jsonl 的 source_id 集合完全相同。"
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exhibition.json",
        "edition.json",
        "companies.jsonl",
        "participations.jsonl",
        "sources.jsonl",
        "crawl_runs.jsonl",
        "changes.jsonl"
      ],
      "properties": {
        "exhibition.json": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "bytes",
            "records"
          ],
          "properties": {
            "sha256": {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            "bytes": {
              "$ref": "common.schema.json#/$defs/count"
            },
            "records": {
              "$ref": "common.schema.json#/$defs/count"
            }
          }
        },
        "edition.json": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "bytes",
            "records"
          ],
          "properties": {
            "sha256": {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            "bytes": {
              "$ref": "common.schema.json#/$defs/count"
            },
            "records": {
              "$ref": "common.schema.json#/$defs/count"
            }
          }
        },
        "companies.jsonl": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "bytes",
            "records"
          ],
          "properties": {
            "sha256": {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            "bytes": {
              "$ref": "common.schema.json#/$defs/count"
            },
            "records": {
              "$ref": "common.schema.json#/$defs/count"
            }
          }
        },
        "participations.jsonl": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "bytes",
            "records"
          ],
          "properties": {
            "sha256": {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            "bytes": {
              "$ref": "common.schema.json#/$defs/count"
            },
            "records": {
              "$ref": "common.schema.json#/$defs/count"
            }
          }
        },
        "sources.jsonl": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "bytes",
            "records"
          ],
          "properties": {
            "sha256": {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            "bytes": {
              "$ref": "common.schema.json#/$defs/count"
            },
            "records": {
              "$ref": "common.schema.json#/$defs/count"
            }
          }
        },
        "crawl_runs.jsonl": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "bytes",
            "records"
          ],
          "properties": {
            "sha256": {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            "bytes": {
              "$ref": "common.schema.json#/$defs/count"
            },
            "records": {
              "$ref": "common.schema.json#/$defs/count"
            }
          }
        },
        "changes.jsonl": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "bytes",
            "records"
          ],
          "properties": {
            "sha256": {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            "bytes": {
              "$ref": "common.schema.json#/$defs/count"
            },
            "records": {
              "$ref": "common.schema.json#/$defs/count"
            }
          }
        }
      }
    },
    "record_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "companies",
        "participations",
        "sources",
        "crawl_runs",
        "changes"
      ],
      "properties": {
        "companies": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "participations": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "sources": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "crawl_runs": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "changes": {
          "$ref": "common.schema.json#/$defs/count"
        }
      }
    },
    "content_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "completeness_status": {
      "$ref": "common.schema.json#/$defs/completeness_status"
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "official_exhibitor_count",
        "official_count_source_id",
        "collected_participation_count"
      ],
      "properties": {
        "official_exhibitor_count": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/count"
            },
            {
              "type": "null"
            }
          ],
          "description": "官方公布的參展商數；未知為 null。"
        },
        "official_count_source_id": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/source_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "official_count_as_of": {
          "$ref": "common.schema.json#/$defs/date"
        },
        "collected_participation_count": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "notes": {
          "$ref": "common.schema.json#/$defs/text"
        }
      }
    },
    "notes": {
      "$ref": "common.schema.json#/$defs/text"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "completeness_status": {
            "const": "complete"
          }
        }
      },
      "then": {
        "properties": {
          "completeness": {
            "properties": {
              "official_exhibitor_count": {
                "$ref": "common.schema.json#/$defs/count"
              },
              "official_count_source_id": {
                "$ref": "common.schema.json#/$defs/source_id"
              }
            }
          }
        }
      }
    }
  ]
}
