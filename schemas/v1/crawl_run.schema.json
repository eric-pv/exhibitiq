{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exhibitiq.invalid/schemas/v1/crawl_run.schema.json",
  "title": "CrawlRun",
  "description": "擷取批次",
  "type": "object",
  "required": [
    "crawl_run_id",
    "exhibition_id",
    "edition_id",
    "crawler",
    "trigger",
    "started_at",
    "finished_at",
    "status",
    "stats"
  ],
  "properties": {
    "crawl_run_id": {
      "$ref": "common.schema.json#/$defs/crawl_run_id"
    },
    "exhibition_id": {
      "$ref": "common.schema.json#/$defs/exhibition_id"
    },
    "edition_id": {
      "$ref": "common.schema.json#/$defs/edition_id"
    },
    "crawler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "$ref": "common.schema.json#/$defs/short_text"
        },
        "version": {
          "$ref": "common.schema.json#/$defs/short_text"
        }
      }
    },
    "code_commit": {
      "$ref": "common.schema.json#/$defs/git_commit"
    },
    "trigger": {
      "type": "string",
      "enum": [
        "manual",
        "schedule",
        "pull_request",
        "import",
        "other"
      ]
    },
    "github_run_url": {
      "$ref": "common.schema.json#/$defs/http_url"
    },
    "started_at": {
      "$ref": "common.schema.json#/$defs/utc_timestamp"
    },
    "finished_at": {
      "$ref": "common.schema.json#/$defs/utc_timestamp"
    },
    "status": {
      "type": "string",
      "enum": [
        "succeeded",
        "partial",
        "failed",
        "cancelled"
      ]
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests_attempted",
        "requests_succeeded",
        "records_extracted",
        "error_count"
      ],
      "properties": {
        "requests_attempted": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "requests_succeeded": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "records_extracted": {
          "$ref": "common.schema.json#/$defs/count"
        },
        "error_count": {
          "$ref": "common.schema.json#/$defs/count"
        }
      }
    },
    "error_samples": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "$ref": "common.schema.json#/$defs/short_text"
          },
          "message": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "url": {
            "$ref": "common.schema.json#/$defs/http_url"
          },
          "occurred_at": {
            "$ref": "common.schema.json#/$defs/utc_timestamp"
          }
        }
      }
    },
    "notes": {
      "$ref": "common.schema.json#/$defs/text"
    }
  },
  "additionalProperties": false
}
